<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A股仓位闸门 Demo" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvMonitorState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="监控：未启动" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="开始监控" />
        <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="停止监控" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnRefresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="刷新一次" />
        <Button android:id="@+id/btnAi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="AI分析" />
        <Button android:id="@+id/btnSettings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="设置" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="市场 / 仓位闸门" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvMarketState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="#EEEEEE" android:padding="12dp" android:text="暂无数据" android:textIsSelectable="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="持仓 / 自选实时行情 + R2" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvQuotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="#F3F3F3" android:fontFamily="monospace" android:padding="12dp" android:text="暂无数据" android:textIsSelectable="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="追加给 AI 的问题（可选）" android:textStyle="bold" />
    <EditText android:id="@+id/etQuestion" android:layout_width="match_parent" android:layout_height="90dp" android:gravity="top" android:hint="例如：哪些仓位应该先减？什么时候允许提高到70%？" android:inputType="textMultiLine" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="AI判断" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvAi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="#E8EAF6" android:minHeight="120dp" android:padding="12dp" android:text="设置页可粘贴配置；AI不可用时本地 E/M/R2 仍独立运行。" android:textIsSelectable="true" />
</LinearLayout>
</ScrollView>
