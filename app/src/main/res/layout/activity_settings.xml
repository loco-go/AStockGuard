<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AStockGuardDemo 设置"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="粘贴 AI 配置 / Session JSON（只在本机解析）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etImportText"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:gravity="top|start"
            android:hint="可直接粘贴完整 JSON；若输入法/剪贴板截断，请使用下方‘从剪贴板直接解析’或‘从文件导入’"
            android:inputType="textMultiLine|textNoSuggestions"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:minLines="12"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/tvImportLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前文本：0 字符"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPasteClipboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="剪贴板直接解析" />

            <Button
                android:id="@+id/btnImportFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="从文件导入" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnParseImport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="解析输入框" />

            <Button
                android:id="@+id/btnClearImport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空输入框" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvImportResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="尚未解析" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="行情：腾讯免费接口（无需 Key）"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText android:id="@+id/etWatchCodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="000636.SZ,000938.SZ,600667.SH" />
        <EditText android:id="@+id/etPositions" android:layout_width="match_parent" android:layout_height="160dp" android:gravity="top" android:hint="代码,名称,股数,成本,角色" android:inputType="textMultiLine" />
        <EditText android:id="@+id/etPositionRatio" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="当前总仓位%" android:inputType="numberDecimal" />
        <EditText android:id="@+id/etRefreshSeconds" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="轮询秒数（3-60）" android:inputType="number" />
        <Button android:id="@+id/btnTestMarket" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="测试腾讯行情" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="AI 主接口" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHATGPT_WEB 已改为 WebView 正常登录模式，参考开源 WebView 包装器思路：不再用 OkHttp + 导入 Token/Cookie 直连私有网页会话接口。首次点击测试后在 WebView 中正常登录即可。Token/Session 输入仅保留兼容旧配置，不会用于 WebView 私有 API 请求。" android:paddingBottom="6dp" />
        <Spinner android:id="@+id/spPrimaryType" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etPrimaryBaseUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Endpoint / Base URL" android:inputType="textUri" />
        <EditText android:id="@+id/etPrimaryApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API Key / accessToken" android:inputType="textPassword" />
        <EditText android:id="@+id/etSessionToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="sessionToken（Web模式，可自动解析）" android:inputType="textPassword" />
        <EditText android:id="@+id/etCookie" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Cookie（可选）" android:inputType="textPassword" />
        <EditText android:id="@+id/etPrimaryModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="model，例如 auto / gpt-5.6" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="备用 AI（可选，主接口 403/429/5xx 时可自动回退）" android:textStyle="bold" />
        <Spinner android:id="@+id/spBackupType" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/etBackupBaseUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="备用 Base URL" android:inputType="textUri" />
        <EditText android:id="@+id/etBackupApiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="备用 Key" android:inputType="textPassword" />
        <EditText android:id="@+id/etBackupModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="备用 model" />
        <EditText android:id="@+id/etExtraHeaders" android:layout_width="match_parent" android:layout_height="80dp" android:gravity="top" android:hint="额外请求头 JSON（可选）" android:inputType="textMultiLine" />
        <Button android:id="@+id/btnTestAi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="测试 AI" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="保存所有设置" />
        <TextView android:id="@+id/tvTestResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" />
    </LinearLayout>
</ScrollView>
