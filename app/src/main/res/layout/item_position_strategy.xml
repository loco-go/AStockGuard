<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="item" type="com.locogo.astockguard.ui.main.StockStrategyUiModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/astock_surface_card"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
        <TextView android:id="@+id/tvQuote" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/astock_text_secondary" />
        <TextView android:id="@+id/tvActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/astock_text_secondary" />
    </LinearLayout>
</layout>
