<?xml version="1.0" encoding="utf-8"?>
<!--
  文件职责：同花顺成交同步状态与文件导入入口；所有操作由用户主动触发，不包含自动券商操作。
  维护约束：资源名称属于代码契约，重命名时同步修改绑定代码并检查无障碍与深浅色效果。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="同花顺持仓与交易同步" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="同步可见持仓和真实成交，用于行情展示、图表买卖点与交易复盘。当前实现只读，不会自动点击或提交委托。" />
            <TextView android:id="@+id/tvEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textStyle="bold" />
            <TextView android:id="@+id/tvCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/astock_surface_card" android:minHeight="100dp" android:padding="12dp" />
            <Button android:id="@+id/btnOpenAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="打开系统辅助功能设置" />
            <Button android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="刷新同步状态" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="识别到的股票" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="已有持仓默认选中，新股票请手动勾选。可核对或补全字段后确认导入；未勾选不会删除本地持仓。候选仅保留在本次应用运行中，重新开始识别前可清空候选。" />
            <TextView android:id="@+id/tvCandidateEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="暂无候选，请打开同花顺持仓页识别后返回。" />
            <LinearLayout android:id="@+id/candidateList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/tvImportResult" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnConfirmPositions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="确认导入所选股票" />
            <Button android:id="@+id/btnClearCandidates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清空候选，重新识别" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="账户数据导入" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="勾选今日收益、累计收益、当前仓位或总资产，核对后单独导入。金额单位为元，仓位单位为%。导入值为页面快照，首页会标明时间。" />
            <LinearLayout android:id="@+id/accountCandidateList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/tvAccountImportResult" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnConfirmAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="确认导入所选账户数据" />
            <Button android:id="@+id/btnClearImportedAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="移除账户导入值，恢复本地计算" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="交割单文件导入" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="支持券商导出的 CSV、TSV 或 TXT 文件。两条同步路径最终写入同一 TradeRecord。" />
            <Button android:id="@+id/btnImport" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="选择交割单文件" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="隐私：不保存辅助功能页面原始文本，只保存股票代码、名称、持仓数量、成本以及结构化成交字段。" android:textColor="@color/astock_text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</layout>
