<?xml version="1.0" encoding="utf-8"?>
<!--
  文件职责：颜色状态选择器，根据 enabled、selected、checked 等界面状态映射语义颜色；状态顺序从具体到默认，避免默认项提前吞掉分支。
  维护约束：资源名称属于代码契约，重命名时同步修改绑定代码并检查无障碍与深浅色效果。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/astock_on_primary" android:state_activated="true" />
    <item android:color="@color/astock_on_primary" android:state_checked="true" />
    <item android:color="@color/astock_text_secondary" />
</selector>
