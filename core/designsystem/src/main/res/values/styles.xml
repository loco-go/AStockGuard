<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AStockGuard.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/astock_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/astock_surface_card</item>
        <item name="strokeColor">@color/astock_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AStockGuard.NavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">42dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/astock_nav_background</item>
        <item name="android:textColor">@color/astock_nav_text</item>
    </style>

    <style name="Widget.AStockGuard.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/astock_primary</item>
        <item name="android:textColor">@color/astock_on_primary</item>
    </style>

    <style name="Widget.AStockGuard.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/astock_border</item>
        <item name="android:textColor">@color/astock_primary</item>
    </style>

    <!-- 用于启动/停止、播放/暂停等互斥操作，激活项与非激活项会交换颜色。 -->
    <style name="Widget.AStockGuard.StateButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/astock_state_button_background</item>
        <item name="android:textColor">@color/astock_state_button_text</item>
    </style>

    <style name="TextAppearance.AStockGuard.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/astock_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AStockGuard.Metric" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/astock_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
